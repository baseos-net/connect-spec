{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baseos.net/connect/schemas/command-envelope.schema.json",
  "title": "BaseOS Connect command envelope",
  "type": "object",
  "required": ["id", "type", "data"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "issued_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "correlation_id": { "type": "string" },
    "data": { "type": "object" }
  }
}
